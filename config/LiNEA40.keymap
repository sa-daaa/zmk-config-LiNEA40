#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6
#define GESTURE 7

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,
            <&zip_xy_to_scroll_mapper>,
            <&scroll_runtime_input_processor>;
    };
    gesture {
        layers = <GESTURE>;
        input-processors = <&zip_mouse_gesture &zip_xy_scaler 0 1>;
    };
};

/ {
    layer_listeners {
        compatible = "zmk,layer-listeners";

        gesture_on_l7 {
            layers = <GESTURE>;
            bindings = <&mouse_gesture_on &mouse_gesture_off>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        ZenkakuHankaku {
            bindings = <&bt BT_SEL 1>;
            key-positions = <5 6>;
        };

        DeleteKey {
            bindings = <&bt BT_SEL 2>;
            key-positions = <15 16>;
        };

        InsertKey {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 9 8>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <38 39>;
        };

        wiyaress {
            bindings = <&to 6>;
            key-positions = <20 30>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        rock {
            bindings = <&kp LG(L)>;
            key-positions = <8 9>;
        };

        leftclike {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
        };

        rightclike {
            bindings = <&mkp MB2>;
            key-positions = <17 18>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q          &kp W         &kp E   &kp R                      &kp T                                                      &kp Y        &kp U  &kp I             &kp O             &kp P
&kp A          &kp S         &kp D   &kp F                      &kp G                                                      &kp H        &kp J  &kp K             &kp L             &lt 1 MINUS
&kp Z          &kp X         &kp C   &kp V                      &kp B                                                      &kp N        &kp M  &lt GESTURE COMMA &kp DOT           &lt 5 SLASH
&mt LCTRL TAB  &kp LEFT_WIN  &trans  &mt LEFT_ALT INT_MUHENKAN  &lt 3 INT_HENKAN  &mt LEFT_SHIFT BACKSPACE    &lt 2 ENTER  &lt 4 SPACE         &lt 5 INT_HENKAN  &kp INT_MUHENKAN  &kp DEL
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &kp LC(A)      &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &kp LC(C)      &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &kp LC(V)      &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp LA(LEFT)  &kp LA(RIGHT)            &trans    &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp COLON  &kp SINGLE_QUOTE  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT                              &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans  &trans  &trans
&kp SEMI   &kp DOLLAR        &kp PERCENT           &kp AMPERSAND          &kp SEMICOLON                            &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans  &trans  &kp UNDER
&kp EQUAL  &kp EXCLAMATION   &kp DQT               &kp HASH               &kp PERIOD                               &kp LS(LC(N))     &trans             &trans  &trans  &kp QUESTION
&kp AT     &trans            &trans                &trans                 &trans         &kp LEFT_SHIFT    &trans  &trans                               &trans  &trans  &kp LA(F4)
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        CURSOR {
            bindings = <
&kp LC(HOME)  &kp LC(LS(TAB))    &kp UP_ARROW  &kp LC(TAB)      &kp LC(END)                    &trans  &trans    &kp UP_ARROW  &trans     &trans
&kp HOME      &kp LEFT_ARROW     &kp DOWN      &kp RIGHT_ARROW  &kp END                        &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans
&trans        &kp LC(PAGE_DOWN)  &trans        &kp LC(PAGE_UP)  &trans                         &trans  &trans    &trans        &trans     &trans
&trans        &kp LEFT_GUI       &trans        &trans           &trans       &trans    &trans  &trans            &trans        &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        //4

        FUNCTION {
            bindings = <
&kp MINUS  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                        &trans     &kp F7  &kp F8  &kp F9  &kp F10
&kp SLASH  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                    &trans     &kp F4  &kp F5  &kp F6  &kp F11
&kp EQUAL  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD                      &kp LG(E)  &kp F1  &kp F2  &kp F3  &kp F12
&kp TAB    &kp KP_NUMBER_0  &trans           &trans           &trans        &trans    &trans  &trans             &trans  &trans  &trans
            >;

            sensor-bindings = <&re_kp TAB LS(TAB)>;
        };

        //5

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        //7

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };
    };
};

&zip_mouse_gesture {
    stroke-size = <200>;
    enable-eager-mode;
    idle-timeout-ms = <150>;
    gesture-cooldown-ms = <300>;

    task_view {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(TAB)>;
    };

    show_desk {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(D)>;
    };

    vdesk_prev {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LC(RIGHT))>;
    };

    vdesk_next {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(LC(LEFT))>;
    };
};
